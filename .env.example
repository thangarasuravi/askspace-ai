# AskSpace AI Configuration
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=dev-secret-key-askspace-ai-replace-in-production

# AI Provider Settings: 'demo', 'gemini', or 'openai'
AI_PROVIDER=demo

# Optional: Google Gemini API Key (if AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI API Key (if AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Defaults to SQLite in instance directory)
# DATABASE_URL=sqlite:///instance/askspace.db
